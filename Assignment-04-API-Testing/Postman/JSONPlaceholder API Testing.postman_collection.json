              "    pm.expect(response.title).to.eql(\"API Testing Assignment\");\r",
              "});\r",
              "\r",
              "pm.test(\"Body is correct\", function () {\r",
              "    const response = pm.response.json();\r",
              "    pm.expect(response.body).to.eql(\"This post was created using Postman\");\r",
              "});\r",
              "\r",
              "pm.test(\"userId is correct\", function () {\r",
              "    const response = pm.response.json();\r",
              "    pm.expect(response.userId).to.eql(1);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
